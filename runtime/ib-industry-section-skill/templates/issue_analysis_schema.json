{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Industry Issue Analysis",
  "description": "Machine-readable issue-by-issue industry analysis produced after research pack drafting. This artifact is not a one-line insight list. Each block covers one IB industry subissue with a substantive analysis paragraph, supporting points, evidence sufficiency, limitations, and downstream usage permission. Page selection and template decisions belong downstream in deck_blueprint.",
  "type": "object",
  "required": ["meta", "issue_analyses", "research_backlog", "rejected_or_deprioritized_analyses"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["target_company", "industry", "geography", "research_as_of_date"],
      "properties": {
        "target_company": { "type": "string" },
        "industry": { "type": "string" },
        "geography": { "type": "string" },
        "research_as_of_date": { "type": "string" }
      },
      "additionalProperties": true
    },
    "issue_analyses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "analysis_id",
          "source_execution_result_ids",
          "issue_area",
          "subissue",
          "analysis_type",
          "core_statement",
          "analysis_text",
          "supporting_points",
          "evidence_sufficiency",
          "evidence_status",
          "allowed_deck_usage",
          "hypothesis_resolution",
          "status",
          "evidence_ids",
          "metric_ids",
          "limitations",
          "downstream_permission"
        ],
        "properties": {
          "analysis_id": { "type": "string", "pattern": "^IA-\\d{3}$" },
          "source_execution_result_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^FR-\\d{3}$" }
          },
          "issue_area": {
            "type": "string",
            "enum": [
              "market_size_growth",
              "demand_customer_logic",
              "industry_structure",
              "key_trends_drivers",
              "competitive_landscape",
              "competitive_dynamics",
              "pitch_relevance_target_context"
            ]
          },
          "subissue": {
            "type": "string",
            "enum": [
              "current_market_size",
              "historical_growth",
              "forecast_growth",
              "market_segmentation",
              "growth_quality",
              "market_cycle",
              "customer_segments",
              "demand_drivers",
              "willingness_to_pay",
              "repeat_or_replacement",
              "channel_behavior",
              "unmet_needs",
              "concentration",
              "value_chain",
              "profit_pool",
              "business_models",
              "barriers_to_entry",
              "supplier_customer_power",
              "secular_tailwinds",
              "headwinds_and_risks",
              "technology_disruption",
              "regulatory_developments",
              "channel_or_go_to_market_shift",
              "mna_and_consolidation",
              "peer_universe",
              "competitor_profiles",
              "peer_financials",
              "strategic_positioning",
              "product_or_service_focus",
              "channel_footprint",
              "recent_developments",
              "valuation_snapshot_peer_fact",
              "basis_of_competition",
              "winners_losers",
              "new_entrants",
              "substitutes_or_adjacent_risk",
              "differentiation_durability",
              "consolidation_logic",
              "why_sector_relevant",
              "target_context_fit",
              "evidence_limits",
              "discussion_implications"
            ]
          },
          "related_subissues": {
            "description": "Optional adjacent subissues touched by this block. The main subissue remains the evidence sufficiency unit.",
            "type": "array",
            "items": { "type": "string" }
          },
          "analysis_type": {
            "type": "string",
            "enum": [
              "descriptive_market_fact",
              "analytical_judgment",
              "driver_analysis",
              "structure_analysis",
              "profit_pool_analysis",
              "barrier_analysis",
              "peer_profile",
              "competitive_dynamic",
              "trend_or_risk",
              "pitch_context",
              "evidence_gap"
            ]
          },
          "core_statement": {
            "type": "string",
            "description": "One sentence summary of the issue-level finding or evidence gap."
          },
          "analysis_text": {
            "type": "string",
            "description": "Substantive issue-level analysis paragraph. This should synthesize evidence and caveats; it is not slide copy."
          },
          "evidence_status": {
            "type": "string",
            "enum": ["supported", "thin", "insufficient", "not_applicable", "unavailable_after_research", "not_researched", "caveat_only"]
          },
          "allowed_deck_usage": {
            "type": "object",
            "required": ["headline", "main_message", "chart", "body_copy"],
            "properties": {
              "headline": { "type": "boolean" },
              "main_message": { "type": "boolean" },
              "chart": { "type": "boolean" },
              "body_copy": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "hypothesis_resolution": {
            "type": "string",
            "enum": ["resolved", "not_researched", "caveat_only", "deprioritized", "rejected"]
          },
          "supporting_points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["point", "evidence_ids", "metric_ids", "role", "evidence_sufficiency"],
              "properties": {
                "point": { "type": "string" },
                "evidence_ids": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^EV-\\d{3}$" }
                },
                "metric_ids": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^MET-\\d{3}$" }
                },
                "role": {
                  "type": "string",
                  "enum": ["primary_fact", "secondary_fact", "calculation", "counterpoint", "caveat", "peer_fact", "open_gap"]
                },
                "evidence_sufficiency": {
                  "type": "string",
                  "enum": ["sufficient", "thin", "insufficient", "not_applicable", "unavailable_after_research"]
                }
              },
              "additionalProperties": false
            }
          },
          "evidence_sufficiency": {
            "type": "string",
            "enum": ["sufficient", "thin", "insufficient", "not_applicable", "unavailable_after_research"]
          },
          "status": {
            "type": "string",
            "enum": ["validated", "partially_validated", "unverified", "rejected"]
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^EV-\\d{3}$" }
          },
          "metric_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^MET-\\d{3}$" }
          },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "downstream_permission": {
            "type": "object",
            "required": ["headline_allowed", "chart_allowed", "body_copy_allowed"],
            "properties": {
              "headline_allowed": { "type": "boolean" },
              "chart_allowed": { "type": "boolean" },
              "body_copy_allowed": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "candidate_use_cases": {
            "description": "Optional, non-binding hints for downstream deck blueprint. Do not use fixed slide numbers here.",
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "research_backlog": {
      "type": "array",
      "description": "Subissues that require more research before downstream deck blueprint may use them as strong claims.",
      "items": {
        "type": "object",
        "required": ["issue_area", "subissue", "reason", "needed_evidence", "research_action", "downstream_permission"],
        "properties": {
          "issue_area": {
            "type": "string",
            "enum": [
              "market_size_growth",
              "demand_customer_logic",
              "industry_structure",
              "key_trends_drivers",
              "competitive_landscape",
              "competitive_dynamics",
              "pitch_relevance_target_context"
            ]
          },
          "subissue": { "type": "string" },
          "attempted_statement": { "type": "string" },
          "reason": { "type": "string" },
          "needed_evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "research_action": {
            "type": "string",
            "enum": ["run_targeted_search", "review_company_filings", "review_peer_data", "request_user_or_management_input", "mark_unavailable_after_research"]
          },
          "downstream_permission": {
            "type": "string",
            "enum": ["do_not_use_for_strong_claim", "use_only_as_context", "supplemental_research_required"]
          }
        },
        "additionalProperties": false
      }
    },
    "rejected_or_deprioritized_analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_execution_result_id", "attempted_statement", "reason", "evidence_ids"],
        "properties": {
          "source_execution_result_id": { "type": "string", "pattern": "^FR-\\d{3}$" },
          "attempted_statement": { "type": "string" },
          "reason": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
