{
  "schema_version": "artifact_manifest_v1",
  "description": "Canonical artifact and gate manifest for the formal IB industry section workflow. Use this file as the machine source of truth for artifact paths, validators, builders, and stale-validation input relationships.",
  "artifacts": {
    "input_card": {
      "path": "input_card.json",
      "owner": "llm_transcription",
      "validator": "scripts/validate_input_card.py",
      "validation": "artifacts/input_card_validation.json",
      "inputs": []
    },
    "industry_scope_pack": {
      "path": "artifacts/industry_scope_pack.json",
      "owner": "llm_scoping",
      "validator": "scripts/validate_industry_scope_pack.py",
      "validation": "artifacts/industry_scope_pack_validation.json",
      "inputs": ["input_card"]
    },
    "formal_search_plan": {
      "path": "artifacts/formal_search_plan.json",
      "owner": "llm_lightweight_planning",
      "validator": "scripts/validate_formal_search_plan.py",
      "validation": "artifacts/formal_search_plan_validation.json",
      "inputs": ["input_card", "industry_scope_pack"]
    },
    "search_log": {
      "path": "artifacts/search_log.md",
      "owner": "script_assisted_research_log",
      "inputs": ["formal_search_plan"]
    },
    "formal_research_execution_report": {
      "path": "artifacts/formal_research_execution_report.json",
      "owner": "script_skeleton_llm_judgment",
      "validator": "scripts/validate_formal_research_execution.py",
      "validation": "artifacts/formal_research_execution_validation.json",
      "inputs": ["formal_search_plan", "search_log"]
    },
    "source_reviews": {
      "path": "artifacts/source_reviews.json",
      "owner": "llm_source_review_audit",
      "validator": "scripts/validate_source_reviews.py",
      "validation": "artifacts/source_reviews_validation.json",
      "inputs": ["search_log", "formal_research_execution_report"]
    },
    "source_archive": {
      "path": "artifacts/source_archive/source_archive_index.json",
      "owner": "script_excerpt_snapshot_builder",
      "validator": "scripts/validate_source_archive.py",
      "validation": "artifacts/source_archive_validation.json",
      "inputs": ["source_reviews"]
    },
    "pre_research_pack_gate": {
      "path": "artifacts/stage_gate_pre_research_pack_validation.json",
      "owner": "script",
      "validator": "scripts/validate_stage_gate.py --stage pre_research_pack",
      "validation": "artifacts/stage_gate_pre_research_pack_validation.json",
      "inputs": ["industry_scope_pack", "formal_search_plan", "search_log", "formal_research_execution_report", "source_reviews", "source_archive"]
    },
    "research_pack": {
      "path": "industry_research_pack.md",
      "owner": "llm",
      "validator": "scripts/validate_research_pack.py",
      "validation": "artifacts/research_pack_validation.json",
      "inputs": ["industry_scope_pack", "formal_search_plan", "search_log", "formal_research_execution_report", "source_reviews", "source_archive"]
    },
    "issue_analysis": {
      "path": "industry_issue_analysis.json",
      "owner": "llm",
      "validator": "scripts/validate_issue_analysis.py",
      "validation": "artifacts/issue_analysis_validation.json",
      "inputs": ["research_pack"]
    },
    "template_registry": {
      "path": "template_registry.json",
      "owner": "script",
      "builder": "scripts/extract_template_registry.py",
      "validator": "scripts/validate_template_registry.py",
      "validation": "artifacts/template_registry_validation.json",
      "inputs": []
    },
    "deck_blueprint": {
      "path": "deck_blueprint.json",
      "owner": "llm_deck_designer",
      "validator": "scripts/validate_deck_blueprint.py",
      "validation": "artifacts/deck_blueprint_validation.json",
      "inputs": ["issue_analysis", "template_registry"]
    },
    "page_evidence_contract": {
      "path": "page_evidence_contract.json",
      "owner": "script",
      "builder": "scripts/compile_deck_blueprint.py",
      "validator": "scripts/validate_page_evidence_contract.py",
      "validation": "artifacts/page_evidence_contract_validation.json",
      "inputs": ["issue_analysis", "deck_blueprint"]
    },
    "renderer_spec": {
      "path": "renderer_spec.json",
      "owner": "script",
      "builder": "scripts/compile_deck_blueprint.py",
      "validator": "scripts/validate_renderer_spec.py",
      "validation": "artifacts/renderer_spec_validation.json",
      "inputs": ["template_registry", "deck_blueprint", "page_evidence_contract"]
    },
    "chart_metric_binding": {
      "path": "artifacts/chart_metric_binding_validation.json",
      "owner": "script",
      "validator": "scripts/validate_chart_metric_binding.py",
      "validation": "artifacts/chart_metric_binding_validation.json",
      "inputs": ["research_pack", "page_evidence_contract", "renderer_spec"]
    },
    "content_quality": {
      "path": "artifacts/content_quality_validation.json",
      "owner": "script",
      "validator": "scripts/validate_content_quality.py",
      "validation": "artifacts/content_quality_validation.json",
      "inputs": ["research_pack", "page_evidence_contract", "renderer_spec"]
    },
    "pre_ppt_gate": {
      "path": "artifacts/stage_gate_pre_ppt_validation.json",
      "owner": "script",
      "validator": "scripts/validate_stage_gate.py --stage pre_ppt",
      "validation": "artifacts/stage_gate_pre_ppt_validation.json",
      "inputs": ["input_card", "industry_scope_pack", "formal_search_plan", "search_log", "formal_research_execution_report", "source_reviews", "source_archive", "research_pack", "issue_analysis", "template_registry", "deck_blueprint", "page_evidence_contract", "renderer_spec", "chart_metric_binding", "content_quality"]
    },
    "replacement_dict": {
      "path": "replacement_dict.json",
      "owner": "script",
      "builder": "scripts/generate_replacement_dict.py",
      "validator": "scripts/validate_replacement_dict.py",
      "validation": "artifacts/replacement_dict_validation.json",
      "inputs": ["renderer_spec", "pre_ppt_gate"]
    },
    "filled_ppt": {
      "path": "industry_section_filled_clean.pptx",
      "owner": "script",
      "builder": "run_pipeline.sh",
      "validator": "scripts/validate_filled_ppt.py",
      "validation": "filled_ppt_validation.json",
      "inputs": ["renderer_spec", "page_evidence_contract", "pre_ppt_gate", "replacement_dict"]
    },
    "final_delivery": {
      "path": "artifacts/final_delivery_validation.json",
      "owner": "script",
      "validator": "scripts/validate_final_delivery.py",
      "validation": "artifacts/final_delivery_validation.json",
      "inputs": ["input_card", "industry_scope_pack", "formal_search_plan", "formal_research_execution_report", "source_reviews", "source_archive", "research_pack", "issue_analysis", "template_registry", "deck_blueprint", "page_evidence_contract", "renderer_spec", "replacement_dict", "filled_ppt"]
    }
  },
  "gates": [
    { "gate": "input_card", "artifact": "input_card" },
    { "gate": "industry_scope_pack", "artifact": "industry_scope_pack" },
    { "gate": "formal_search_plan", "artifact": "formal_search_plan" },
    { "gate": "formal_research_execution", "artifact": "formal_research_execution_report" },
    { "gate": "source_reviews", "artifact": "source_reviews" },
    { "gate": "source_archive", "artifact": "source_archive" },
    { "gate": "pre_research_pack", "artifact": "pre_research_pack_gate" },
    { "gate": "research_pack", "artifact": "research_pack" },
    { "gate": "issue_analysis", "artifact": "issue_analysis" },
    { "gate": "template_registry", "artifact": "template_registry" },
    { "gate": "deck_blueprint", "artifact": "deck_blueprint" },
    { "gate": "page_evidence_contract", "artifact": "page_evidence_contract" },
    { "gate": "renderer_spec", "artifact": "renderer_spec" },
    { "gate": "chart_metric_binding", "artifact": "chart_metric_binding" },
    { "gate": "content_quality", "artifact": "content_quality" },
    { "gate": "pre_ppt", "artifact": "pre_ppt_gate" },
    { "gate": "replacement_dict", "artifact": "replacement_dict" },
    { "gate": "filled_ppt", "artifact": "filled_ppt" },
    { "gate": "final_delivery", "artifact": "final_delivery", "require_client_ready": true }
  ]
}
