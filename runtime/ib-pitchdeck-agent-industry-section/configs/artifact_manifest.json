{
  "schema_version": "artifact_manifest_v1",
  "description": "Registered artifact and review-routing manifest for the IB industry section workflow. Use this file for artifact paths, ownership, layers, and stale-check input relationships; do not treat it as the page-story checklist or command index.",
  "operator_guidance": "The mental workflow is owner-action first: LLM roles author boundaries, evidence decisions, page arguments, and readiness calls. Helper tools live in pipeline/status helpers; this manifest should not list command recipes. The context sequence is only a from-scratch orientation, not a backfill requirement; if a downstream authored evidence DB or page pack already exists, repair that source of truth instead of recreating earlier workbenches for appearance.",
  "artifact_layers": {
    "authoring": {
      "description": "Editable LLM work surfaces for substantive transcription, query authoring, research judgment, evidence extraction, and page design. The context sequence is for fresh starts; once downstream authored work exists, it is not a requirement to backfill earlier workbenches.",
      "from_scratch_context_sequence": [
        "input_card",
        "industry_scope_pack",
        "formal_search_plan",
        "executable_search_batch",
        "research_graph_state",
        "research_evidence_db",
        "banker_page_pack"
      ],
      "artifacts": [
        "material_extracts",
        "input_card",
        "industry_scope_pack",
        "formal_search_plan",
        "executable_search_batch",
        "research_graph_state",
        "research_evidence_db",
        "research_request_queue",
        "banker_page_pack"
      ]
    },
    "derived": {
      "description": "Deterministic/helper artifacts generated from user input, execution state, or authoring artifacts. Do not hand-author these for formal delivery.",
      "artifacts": [
        "material_manifest",
        "source_classification",
        "coverage_map",
        "search_log",
        "formal_research_execution_report",
        "coverage_accounting",
        "source_archive",
        "template_selection",
        "template_profile",
        "template_fit_validation",
        "template_fit_plan",
        "research_pack",
        "template_registry",
        "deck_blueprint",
        "page_evidence_contract",
        "renderer_spec",
        "filled_ppt"
      ]
    },
    "readiness": {
      "description": "Structure readiness outputs. They report whether upstream authored work can move forward; they are not content-authoring surfaces.",
      "artifacts": [
        "pre_ppt_readiness",
        "final_delivery"
      ]
    },
    "diagnostic": {
      "description": "Optional helper artifacts for debugging or role handoff. They are not part of the main workflow path and should not be required for delivery.",
      "artifacts": [
        "industry_boundary_qc",
        "status_report"
      ]
    }
  },
  "role_layers": {
    "material-intake": {
      "description": "User-provided materials, source classification, explicit extraction, and normalized input card.",
      "artifacts": [
        "material_manifest",
        "material_extracts",
        "source_classification",
        "input_card"
      ]
    },
    "industry-scoping": {
      "description": "Target industry definition, boundary review, excluded scope, and scope risk mapping.",
      "artifacts": [
        "industry_scope_pack",
        "industry_boundary_qc"
      ]
    },
    "research-external-evidence": {
      "description": "Formal search plan, actual search log, public/manual evidence collection, archive, and formal execution accounting.",
      "artifacts": [
        "formal_search_plan",
        "coverage_map",
        "executable_search_batch",
        "research_graph_state",
        "search_log",
        "source_archive",
        "formal_research_execution_report",
        "coverage_accounting"
      ]
    },
    "knowledge-repository": {
      "description": "Evidence database, facts, metrics, conflicts, gaps, and readable research-pack export.",
      "artifacts": [
        "research_evidence_db",
        "research_pack"
      ]
    },
    "reasoning": {
      "description": "Research request routing only; banker judgment lives in banker_page_pack.",
      "artifacts": [
        "research_request_queue"
      ]
    },
    "generation": {
      "description": "Banker page pack authoring plus optional deterministic helpers for the structured-render path.",
      "artifacts": [
        "banker_page_pack",
        "template_registry",
        "deck_blueprint",
        "page_evidence_contract",
        "renderer_spec"
      ]
    },
    "template": {
      "description": "Template style/profile guidance and style-guided content fit.",
      "artifacts": [
        "template_profile",
        "template_selection",
        "template_fit_validation",
        "template_fit_plan"
      ]
    },
    "qc": {
      "description": "Small structure readiness layer. LLM owns content-quality review.",
      "artifacts": [
        "pre_ppt_readiness",
        "final_delivery",
        "status_report"
      ]
    },
    "output": {
      "description": "Deterministic PPT rendering, cleanup, and filled-PPT package checks.",
      "artifacts": [
        "filled_ppt"
      ]
    }
  },
  "artifacts": {
    "material_manifest": {
      "path": "artifacts/material_manifest.json",
      "owner": "pipeline_material_intake_record",
      "inputs": []
    },
    "material_extracts": {
      "path": "artifacts/material_extracts.json",
      "owner": "llm_fact_extraction_workspace",
      "inputs": [
        "material_manifest"
      ]
    },
    "source_classification": {
      "path": "artifacts/source_classification.json",
      "owner": "pipeline_material_source_classification",
      "inputs": [
        "material_manifest"
      ]
    },
    "input_card": {
      "path": "input_card.json",
      "owner": "llm_transcription",
      "inputs": []
    },
    "industry_scope_pack": {
      "path": "artifacts/industry_scope_pack.json",
      "owner": "industry-scoping",
      "purpose": "brief boundary card",
      "schema_version": "industry_scope_pack_boundary_card",
      "inputs": [
        "input_card"
      ]
    },
    "industry_boundary_qc": {
      "path": "artifacts/industry_boundary_qc.json",
      "owner": "llm_qc_boundary_review",
      "purpose": "Optional LLM boundary review signal when scope ambiguity could change research direction.",
      "schema_version": "industry_boundary_qc",
      "inputs": [
        "industry_scope_pack"
      ]
    },
    "formal_search_plan": {
      "path": "artifacts/formal_search_plan.json",
      "owner": "llm_research_planning_workbench",
      "inputs": [
        "input_card",
        "industry_scope_pack"
      ]
    },
    "coverage_map": {
      "path": "artifacts/coverage_map.json",
      "owner": "deterministic_coverage_map",
      "inputs": [
        "formal_search_plan"
      ]
    },
    "executable_search_batch": {
      "path": "artifacts/executable_search_batch.json",
      "owner": "llm_query_author_workspace",
      "display_name": "executable_search_batch",
      "purpose": "Executable query workbench and the only editable query-authoring artifact.",
      "inputs": [
        "formal_search_plan"
      ]
    },
    "research_graph_state": {
      "path": "artifacts/research_graph_state.json",
      "owner": "research_execution_workbench",
      "purpose": "Editable execution state for actual attempts, reviewed sources, and source-specific EV/MET capture.",
      "inputs": [
        "formal_search_plan",
        "executable_search_batch"
      ]
    },
    "search_log": {
      "path": "artifacts/search_log.md",
      "owner": "deterministic_research_log_export",
      "inputs": [
        "formal_search_plan"
      ]
    },
    "formal_research_execution_report": {
      "path": "artifacts/formal_research_execution_report.json",
      "owner": "deterministic_execution_report_export",
      "inputs": [
        "formal_search_plan",
        "search_log",
        "source_archive"
      ]
    },
    "coverage_accounting": {
      "path": "artifacts/coverage_accounting.json",
      "owner": "deterministic_coverage_accounting_export",
      "inputs": [
        "formal_research_execution_report"
      ]
    },
    "source_archive": {
      "path": "artifacts/source_archive/source_archive_index.json",
      "owner": "deterministic_archive_capture_index",
      "inputs": [
        "search_log"
      ]
    },
    "template_profile": {
      "path": "artifacts/template_profile.json",
      "owner": "deterministic_template_profile",
      "inputs": [
        "template_selection"
      ]
    },
    "template_selection": {
      "path": "artifacts/template_selection.json",
      "owner": "pipeline_template_selection_record",
      "inputs": [
        "material_manifest",
        "source_classification"
      ]
    },
    "template_fit_validation": {
      "path": "artifacts/template_fit_validation.json",
      "owner": "deterministic_template_fit_check",
      "inputs": [
        "template_profile",
        "renderer_spec"
      ]
    },
    "template_fit_plan": {
      "path": "artifacts/template_fit_plan.json",
      "owner": "deterministic_template_fit_plan",
      "inputs": [
        "template_profile",
        "renderer_spec",
        "template_fit_validation"
      ]
    },
    "research_request_queue": {
      "path": "artifacts/research_request_queue.json",
      "owner": "reasoning_llm_research_request_author",
      "purpose": "LLM-authored bounded request queue for evidence that could change page inclusion, headline assertiveness, key data audit, or exhibit readiness.",
      "inputs": [
        "banker_page_pack",
        "research_evidence_db"
      ]
    },
    "research_pack": {
      "path": "industry_research_pack.md",
      "owner": "deterministic_export_from_research_evidence_db",
      "inputs": [
        "research_evidence_db"
      ]
    },
    "research_evidence_db": {
      "path": "artifacts/research_evidence_db.json",
      "owner": "knowledge_llm_evidence_authoring",
      "purpose": "Knowledge LLM-authored evidence database. Candidate extracts are only a workspace; they do not promote EV/MET rows.",
      "inputs": [
        "industry_scope_pack",
        "formal_search_plan",
        "search_log",
        "formal_research_execution_report",
        "coverage_accounting",
        "source_archive"
      ]
    },
    "banker_page_pack": {
      "path": "banker_page_pack.json",
      "owner": "llm_banker_page_author",
      "purpose": "single LLM-authored pre-mandate page pack: banker judgment, exhibit design, dense copy, metrics, evidence bindings, and transaction relevance",
      "schema_version": "banker_page_pack",
      "inputs": [
        "industry_scope_pack",
        "research_evidence_db"
      ]
    },
    "template_registry": {
      "path": "template_registry.json",
      "owner": "deterministic_template_registry",
      "purpose": "Optional structured-render helper describing template style and available layout hints; not a page-story source.",
      "inputs": []
    },
    "deck_blueprint": {
      "path": "deck_blueprint.json",
      "owner": "structured_render_helper_from_banker_page_pack",
      "purpose": "Optional structured-render helper derived from banker_page_pack; do not author page arguments here.",
      "inputs": [
        "banker_page_pack"
      ]
    },
    "page_evidence_contract": {
      "path": "page_evidence_contract.json",
      "owner": "deterministic_page_evidence_contract",
      "purpose": "Optional structured-render helper carrying evidence bindings already selected in banker_page_pack.",
      "inputs": [
        "banker_page_pack",
        "deck_blueprint"
      ]
    },
    "renderer_spec": {
      "path": "renderer_spec.json",
      "owner": "deterministic_renderer_spec",
      "purpose": "Optional render instruction helper for editable PPT output after page judgment is ready.",
      "inputs": [
        "template_registry",
        "banker_page_pack",
        "deck_blueprint",
        "page_evidence_contract"
      ]
    },
    "status_report": {
      "path": "artifacts/status_report.json",
      "owner": "pipeline_status_dashboard",
      "inputs": []
    },
    "pre_ppt_readiness": {
      "path": "artifacts/pre_ppt_readiness.json",
      "owner": "deterministic_readiness_check",
      "inputs": [
        "banker_page_pack",
        "template_selection",
        "template_profile",
        "template_registry",
        "deck_blueprint",
        "page_evidence_contract",
        "renderer_spec"
      ]
    },
    "filled_ppt": {
      "path": "industry_section_filled_clean.pptx",
      "alternate_output_marker": "LATEST_FINAL_PPT.txt",
      "owner": "output_render_or_direct_ppt_composition",
      "inputs": [
        "banker_page_pack",
        "template_selection",
        "template_profile"
      ],
      "optional_trace_inputs": [
        "template_registry",
        "renderer_spec",
        "page_evidence_contract"
      ]
    },
    "final_delivery": {
      "path": "artifacts/final_delivery_validation.json",
      "owner": "deterministic_final_delivery_check",
      "inputs": [
        "input_card",
        "research_evidence_db",
        "banker_page_pack",
        "filled_ppt"
      ],
      "optional_trace_inputs": [
        "industry_scope_pack",
        "formal_search_plan",
        "formal_research_execution_report",
        "coverage_accounting",
        "source_archive",
        "research_pack",
        "template_registry",
        "deck_blueprint",
        "page_evidence_contract",
        "renderer_spec",
        "template_selection",
        "template_profile",
        "template_fit_validation",
        "template_fit_plan"
      ]
    }
  },
  "readiness_reviews": [
    {
      "review": "pre_ppt",
      "artifact": "pre_ppt_readiness"
    },
    {
      "review": "final_delivery",
      "artifact": "final_delivery",
      "require_final_delivery_authorization": true
    }
  ]
}
