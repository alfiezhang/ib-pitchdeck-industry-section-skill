{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QC Repair Report",
  "type": "object",
  "required": ["schema_version", "is_valid", "blocking_issue_count", "issues"],
  "properties": {
    "schema_version": { "type": "string", "const": "qc_repair_report_v1" },
    "is_valid": { "type": "boolean" },
    "blocking_issue_count": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "severity",
          "layer",
          "artifact",
          "field_path",
          "message",
          "why_it_matters",
          "repair_owner",
          "repair_action",
          "rerun_command",
          "downstream_blocked"
        ],
        "properties": {
          "issue_id": { "type": "string" },
          "severity": { "type": "string" },
          "layer": { "type": "string" },
          "artifact": { "type": "string" },
          "field_path": { "type": "string" },
          "message": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "repair_owner": { "type": "string" },
          "repair_action": { "type": "string" },
          "rerun_command": { "type": "string" },
          "downstream_blocked": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
