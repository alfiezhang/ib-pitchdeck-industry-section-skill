{
  "schema_version": "artifact_manifest_v1",
  "description": "Canonical artifact and gate manifest for the formal IB industry section workflow. Use this file as the machine source of truth for artifact paths, validators, builders, and stale-validation input relationships.",
  "artifact_layers": {
    "authoring": {
      "description": "Artifacts where the LLM performs substantive transcription, research judgment, evidence extraction, or page design. This is the main mental path.",
      "main_llm_authoring_path": ["input_card", "material_extracts", "industry_scope_pack", "boundary_loop_status", "formal_search_plan", "research_evidence_db", "hypothesis_store", "issue_analysis", "deck_blueprint"],
      "artifacts": [
        "material_manifest",
        "material_extracts",
        "source_classification",
        "repository_retrieval",
        "repository_index",
        "repository_fingerprints",
        "repository_validation",
        "input_card",
        "industry_scope_pack",
        "boundary_loop_status",
        "industry_boundary_qc",
        "boundary_research_requests",
        "formal_search_plan",
        "coverage_map",
        "search_batch",
        "search_log",
        "source_reviews",
        "formal_research_execution_report",
        "coverage_accounting",
        "research_evidence_db",
        "hypothesis_store",
        "research_request_queue",
        "page_argument_pack",
        "issue_analysis",
        "deck_blueprint"
      ]
    },
    "derived": {
      "description": "Deterministic artifacts generated from authoring artifacts. Do not hand-author these for formal delivery.",
      "artifacts": [
        "source_archive",
        "template_profile",
        "template_fit_validation",
        "template_fit_plan",
        "research_pack",
        "template_registry",
        "page_evidence_contract",
        "renderer_spec",
        "replacement_dict",
        "filled_ppt"
      ]
    },
    "validation": {
      "description": "Gate and validation artifacts. Repair upstream authoring files instead of editing these outputs.",
      "artifacts": [
        "pre_research_pack_gate",
        "chart_metric_binding",
        "content_quality",
        "pre_ppt_gate",
        "final_delivery"
      ]
    },
    "diagnostic": {
      "description": "Optional helper artifacts for debugging or role handoff. They are not part of the main workflow path and should not be required for delivery.",
      "artifacts": [
        "evidence_candidate_skeleton",
        "banker_review_report",
        "agent_handoff",
        "handoff_material_to_scoping",
        "handoff_material_to_scoping_md",
        "handoff_scoping_to_research",
        "handoff_scoping_to_research_md",
        "handoff_research_to_reasoning",
        "handoff_research_to_reasoning_md",
        "handoff_reasoning_to_generation",
        "handoff_reasoning_to_generation_md",
        "handoff_generation_to_template",
        "handoff_generation_to_template_md",
        "handoff_template_to_output",
        "handoff_template_to_output_md",
        "mission_state",
        "failure_memory",
        "run_quality_summary",
        "qc_router_report",
        "qc_repair_brief_json",
        "qc_repair_brief_md",
        "incremental_search_plan",
        "plugin_package_validation",
        "legacy_install_audit"
      ]
    }
  },
  "role_layers": {
    "material-intake": {
      "description": "User-provided materials, source classification, explicit extraction, and normalized input card.",
      "artifacts": ["material_manifest", "material_extracts", "source_classification", "input_card"]
    },
    "industry-scoping": {
      "description": "Target industry definition, boundary validation, excluded scope, and scope risk mapping.",
      "artifacts": ["industry_scope_pack", "boundary_loop_status", "industry_boundary_qc", "boundary_research_requests"]
    },
    "research-external-evidence": {
      "description": "Formal search plan, actual search log, public/manual evidence collection, reviewed sources, archive, and formal execution accounting.",
      "artifacts": [
        "formal_search_plan",
        "coverage_map",
        "search_batch",
        "search_log",
        "source_reviews",
        "source_archive",
        "formal_research_execution_report",
        "coverage_accounting",
        "pre_research_pack_gate",
        "evidence_candidate_skeleton"
      ]
    },
    "knowledge-repository": {
      "description": "Evidence database, facts, metrics, conflicts, gaps, and readable research-pack export.",
      "artifacts": [
        "research_evidence_db",
        "research_pack",
        "repository_retrieval",
        "repository_index",
        "repository_fingerprints",
        "repository_validation"
      ]
    },
    "reasoning": {
      "description": "Banker judgments, hypothesis resolution, research requests, and issue analysis.",
      "artifacts": ["hypothesis_store", "research_request_queue", "incremental_search_plan", "page_argument_pack", "issue_analysis"]
    },
    "generation": {
      "description": "Page arguments, deck blueprint, template registry usage, evidence contract, and renderer spec.",
      "artifacts": ["template_registry", "deck_blueprint", "page_evidence_contract", "renderer_spec", "banker_review_report"]
    },
    "template": {
      "description": "Template style/profile analysis and content-to-template capacity fit.",
      "artifacts": ["template_profile", "template_fit_validation", "template_fit_plan"]
    },
    "qc": {
      "description": "Cross-layer validation, gate status, repair targets, and final delivery audit.",
      "artifacts": [
        "chart_metric_binding",
        "content_quality",
        "pre_ppt_gate",
        "final_delivery",
        "run_quality_summary",
        "agent_handoff",
        "handoff_material_to_scoping",
        "handoff_material_to_scoping_md",
        "handoff_scoping_to_research",
        "handoff_scoping_to_research_md",
        "handoff_research_to_reasoning",
        "handoff_research_to_reasoning_md",
        "handoff_reasoning_to_generation",
        "handoff_reasoning_to_generation_md",
        "handoff_generation_to_template",
        "handoff_generation_to_template_md",
        "handoff_template_to_output",
        "handoff_template_to_output_md",
        "qc_router_report",
        "qc_repair_brief_json",
        "qc_repair_brief_md",
        "plugin_package_validation",
        "legacy_install_audit",
        "mission_state",
        "failure_memory"
      ]
    },
    "output": {
      "description": "Deterministic replacement dictionary, PPT rendering, cleanup, and filled-PPT validation.",
      "artifacts": ["replacement_dict", "filled_ppt"]
    }
  },
