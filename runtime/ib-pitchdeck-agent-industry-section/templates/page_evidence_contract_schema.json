{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page Evidence Contract",
  "description": "Page-level permissions and evidence boundaries deterministically derived from issue analysis and deck_blueprint. It records what the page answer is allowed to claim before renderer_spec compilation; agents should build it with scripts/compile_deck_blueprint.py rather than hand-writing it.",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "slide_no",
          "page_role",
          "page_question",
          "primary_issue_analysis_id",
          "supporting_issue_analysis_ids",
          "headline_claim",
          "proof_standard",
          "headline_allowed",
          "main_message_allowed",
          "downstream_permission",
          "evidence_status",
          "chart_allowed",
          "visual_metric_allowed",
          "chart_metric_ids",
          "allowed_visual_metric_ids",
          "selected_issue_downstream_permissions",
          "body_evidence_ids",
          "proof_points",
          "claim_strength",
          "evidence_gap_handling",
          "caveats",
          "open_questions"
        ],
        "properties": {
          "slide_no": { "type": "integer", "minimum": 1, "maximum": 8 },
          "page_role": { "type": "string" },
          "page_question": {
            "type": "string",
            "description": "The single page-level question this slide must answer. This is proof responsibility, not visual design."
          },
          "primary_issue_analysis_id": { "type": "string", "pattern": "^IA-\\d{3}$" },
          "supporting_issue_analysis_ids": { "type": "array", "items": { "type": "string", "pattern": "^IA-\\d{3}$" } },
          "headline_claim": { "type": "string" },
          "proof_standard": {
            "type": "string",
            "description": "What evidence standard must be met before the headline/chart/body claim is allowed."
          },
          "headline_allowed": { "type": "boolean" },
          "main_message_allowed": { "type": "boolean" },
          "downstream_permission": {
            "type": "object",
            "required": ["headline_allowed", "main_message_allowed", "chart_allowed", "body_copy_allowed"],
            "properties": {
              "headline_allowed": { "type": "boolean" },
              "main_message_allowed": { "type": "boolean" },
              "chart_allowed": { "type": "boolean" },
              "body_copy_allowed": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "chart_allowed": { "type": "boolean" },
          "visual_metric_allowed": {
            "type": "boolean",
            "description": "True when the chosen visual capability may display material metrics in chart/table/cards/matrices."
          },
          "evidence_status": {
            "type": "string",
            "enum": ["supported", "thin", "insufficient", "not_applicable", "unavailable_after_research", "not_researched", "caveat_only"]
          },
          "chart_metric_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^MET-\\d{3}$" }
          },
          "allowed_visual_metric_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^MET-\\d{3}$" },
            "description": "All MET IDs allowed in material visual elements, including non-chart tables/cards/matrices."
          },
          "selected_issue_downstream_permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["analysis_id", "evidence_status", "downstream_permission"],
              "properties": {
                "analysis_id": { "type": "string", "pattern": "^IA-\\d{3}$" },
                "evidence_status": {
                  "type": "string",
                  "enum": ["supported", "thin", "insufficient", "not_applicable", "unavailable_after_research", "not_researched", "caveat_only"]
                },
                "downstream_permission": {
                  "type": "object",
                  "required": ["headline_allowed", "main_message_allowed", "chart_allowed", "body_copy_allowed"],
                  "properties": {
                    "headline_allowed": { "type": "boolean" },
                    "main_message_allowed": { "type": "boolean" },
                    "chart_allowed": { "type": "boolean" },
                    "body_copy_allowed": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "body_evidence_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^EV-\\d{3}$" }
          },
          "proof_points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["point", "source_analysis_ids", "evidence_ids", "metric_ids", "claim_strength"],
              "properties": {
                "point": { "type": "string" },
                "source_analysis_ids": { "type": "array", "items": { "type": "string", "pattern": "^IA-\\d{3}$" } },
                "evidence_ids": { "type": "array", "items": { "type": "string", "pattern": "^EV-\\d{3}$" } },
                "metric_ids": { "type": "array", "items": { "type": "string", "pattern": "^MET-\\d{3}$" } },
                "claim_strength": {
                  "type": "string",
                  "enum": ["hard_fact", "supported_inference", "directional_inference", "management_claim", "hypothesis", "open_question"]
                },
                "visual_role": { "type": "string" },
                "caveat": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "claim_strength": {
            "type": "string",
            "enum": ["hard_fact", "supported_inference", "directional_inference", "management_claim", "hypothesis", "open_question"]
          },
          "evidence_gap_handling": {
            "type": "string",
            "description": "What to do if required evidence is thin, conflicting, unavailable, or only management-provided."
          },
          "dependency_note": {
            "type": "string",
            "description": "Optional page dependency note, such as relies on Slide 1 market definition or should be drafted after competitive landscape."
          },
          "caveats": { "type": "array", "items": { "type": "string" } },
          "open_questions": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
