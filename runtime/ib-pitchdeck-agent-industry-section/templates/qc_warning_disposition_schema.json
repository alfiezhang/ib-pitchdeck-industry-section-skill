{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QC Warning Disposition",
  "type": "object",
  "required": [
    "schema_version",
    "run_dir",
    "generated_at",
    "warning_count",
    "unresolved_warning_count",
    "warnings"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "qc_warning_disposition_v1" },
    "run_dir": { "type": "string" },
    "generated_at": { "type": "string" },
    "warning_count": { "type": "integer", "minimum": 0 },
    "unresolved_warning_count": { "type": "integer", "minimum": 0 },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "warning_id",
          "source_issue_id",
          "source_report",
          "category",
          "layer",
          "artifact",
          "field_path",
          "message",
          "repair_owner",
          "disposition",
          "requires_qc_disposition",
          "downstream_blocked",
          "downstream_limit",
          "accepted_by",
          "acceptance_rationale",
          "rerun_command"
        ],
        "properties": {
          "warning_id": { "type": "string" },
          "source_issue_id": { "type": "string" },
          "source_report": { "type": "string" },
          "category": { "type": "string" },
          "layer": { "type": "string" },
          "artifact": { "type": "string" },
          "field_path": { "type": "string" },
          "message": { "type": "string" },
          "repair_owner": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": [
              "unresolved",
              "advisory_only",
              "repair_before_downstream",
              "qc_accept_with_limits"
            ]
          },
          "requires_qc_disposition": { "type": "boolean" },
          "downstream_blocked": { "type": "boolean" },
          "downstream_limit": { "type": "string" },
          "accepted_by": { "type": "string" },
          "acceptance_rationale": { "type": "string" },
          "rerun_command": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
