{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template Registry",
  "description": "Deterministic capability map extracted from the fixed PPT template and layout registries.",
  "type": "object",
  "required": ["schema_version", "template_file", "slides"],
  "properties": {
    "schema_version": { "type": "string", "const": "template_registry_v1" },
    "template_file": { "type": "string" },
    "slides": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["slide_no", "fixed_page_role", "slide_key", "selection_mode", "variants"],
        "properties": {
          "slide_no": { "type": "integer", "minimum": 1, "maximum": 8 },
          "fixed_page_role": { "type": "string" },
          "slide_key": { "type": "string" },
          "selection_mode": { "type": "string", "enum": ["fixed", "controlled_choice"] },
          "default_variant": { "type": "string" },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "page_type",
                "renderer",
                "formal_allowed",
                "supports",
                "required_body_fields",
                "field_roles"
              ],
              "properties": {
                "page_type": { "type": "string" },
                "renderer": { "type": "string" },
                "formal_allowed": { "type": "boolean" },
                "render_layout_key": { "type": "string" },
                "physical_slide": { "type": "string" },
                "supports": {
                  "type": "object",
                  "required": ["chart", "table", "matrix", "cards"],
                  "properties": {
                    "chart": { "type": "boolean" },
                    "table": { "type": "boolean" },
                    "matrix": { "type": "boolean" },
                    "cards": { "type": "boolean" }
                  },
                  "additionalProperties": false
                },
                "required_body_fields": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "field_roles": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "capacity_notes": {
                  "type": "object",
                  "additionalProperties": true
                },
                "deprecation_status": {
                  "type": "string",
                  "enum": ["active", "debug_only", "deprecated"]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
