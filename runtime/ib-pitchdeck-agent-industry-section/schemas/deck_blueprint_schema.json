{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deck Blueprint",
  "description": "LLM-authored page design artifact. It owns the storyline, slide thesis, layout choice, visible copy, visual intent, and evidence bindings. Scripts compile it into page_evidence_contract.json and renderer_spec.json.",
  "type": "object",
  "required": ["schema_version", "deck_storyline", "slides"],
  "properties": {
    "schema_version": { "type": "string", "const": "deck_blueprint_v1" },
    "section_meta": {
      "type": "object",
      "additionalProperties": true
    },
    "deck_storyline": {
      "type": "string",
      "description": "One concise paragraph explaining the industry section's banker storyline."
    },
    "slides": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "slide_no",
          "fixed_page_role",
          "investor_question",
          "page_thesis",
          "page_argument",
          "visual_intent",
          "evidence_role",
          "page_argument_ids",
          "issue_analysis_ids",
          "selected_page_type",
          "claim_strength",
          "headline",
          "main_message",
          "body_blocks"
        ],
        "properties": {
          "slide_no": { "type": "integer", "minimum": 1 },
          "fixed_page_role": { "type": "string" },
          "investor_question": { "type": "string" },
          "page_thesis": { "type": "string" },
          "page_argument": {
            "type": "string",
            "description": "The one-line evidence-backed page argument for this slide before execution into headline/body/copy."
          },
          "visual_intent": {
            "type": "string",
            "description": "Explicit intent of visual + copy combination (e.g., prove scale through chart evidence, or make a directional comparison through cards)."
          },
          "evidence_role": {
            "type": "string",
            "enum": ["thesis_anchor", "supporting_evidence", "context_setting", "caveat_only", "open_question"],
            "description": "How this slide contributes to downstream deck evidence chain."
          },
          "why_this_page_matters": { "type": "string" },
          "issue_analysis_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^IA-\\d{3}$" }
          },
          "page_argument_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^PA-\\d{3}$" }
          },
          "selected_page_type": { "type": "string" },
          "claim_strength": {
            "type": "string",
            "enum": ["hard_fact", "supported_inference", "directional_inference", "management_claim", "hypothesis", "open_question"]
          },
          "headline": { "type": "string" },
          "main_message": { "type": "string" },
          "body_blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "copy", "evidence_ids", "metric_ids"],
              "properties": {
                "role": { "type": "string" },
                "target_field": {
                  "type": "string",
                  "description": "Optional active template body field to receive this block, e.g. top_left, bottom_center, card_1, right_mid. Use when block order alone would lose page-design intent."
                },
                "template_field": {
                  "type": "string",
                  "description": "Alias for target_field."
                },
                "copy": { "type": "string" },
                "source_analysis_ids": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^IA-\\d{3}$" }
                },
                "evidence_ids": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^EV-\\d{3}$" }
                },
                "metric_ids": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^MET-\\d{3}$" }
                },
                "claim_strength": {
                  "type": "string",
                  "enum": ["hard_fact", "supported_inference", "directional_inference", "management_claim", "hypothesis", "open_question"]
                }
              },
              "additionalProperties": true
            }
          },
          "body_copy": {
            "type": "object",
            "description": "Optional advanced escape hatch when the agent deliberately writes exact active template fields. Prefer body_blocks.",
            "additionalProperties": { "type": "string" }
          },
          "visual_design": {
            "type": "object",
            "additionalProperties": true
          },
          "chart_data": {
            "type": "object",
            "additionalProperties": true
          },
          "compare_table_data": {
            "type": "object",
            "additionalProperties": true
          },
          "visible_metric_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["location", "display_text", "metric_ids", "usage_type"],
              "properties": {
                "location": { "type": "string" },
                "display_text": { "type": "string" },
                "metric_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^MET-\\d{3}$" }
                },
                "usage_type": {
                  "type": "string",
                  "enum": ["direct_display", "calculated_display", "ranking", "peer_comparison", "context_only"]
                },
                "calculation_note": { "type": "string" },
                "basis_note": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "source_note": { "type": "string" },
          "pitch_relevance": { "type": "string" },
          "strategy_checks": {
            "type": "object",
            "additionalProperties": true
          },
          "caveats": {
            "type": "array",
            "items": { "type": "string" }
          },
          "open_questions": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
