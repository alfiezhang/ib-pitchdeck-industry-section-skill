{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Full-Taxonomy Formal Search Plan",
  "description": "Industry-scope-pack-driven coverage and evidence-need plan. Executable queries belong only in executable_search_batch.json. The schema documents shape; scripts/qc/validators/research/validate_formal_search_plan.py enforces full taxonomy coverage before formal searches.",
  "type": "object",
    "required": ["schema_version", "meta", "industry_scope_pack", "plan_mode", "issue_search_plan"],
  "properties": {
    "schema_version": { "const": "formal_search_plan_v1" },
    "meta": { "type": "object", "additionalProperties": true },
    "plan_mode": {
      "type": "string",
      "const": "coverage_audit"
    },
    "industry_scope_pack": { "type": "object", "additionalProperties": true },
    "issue_search_plan": {
      "type": "array",
      "items": {
        "type": "object",
          "required": ["issue_area", "subissue", "research_question", "priority", "execution_expectation", "minimum_actual_searches", "coverage_required", "terminal_status", "search_instructions"],
        "properties": {
          "issue_area": { "type": "string" },
          "subissue": { "type": "string" },
          "research_question": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "execution_expectation": { "type": "string", "enum": ["deep_search", "light_search", "accounting_only"] },
          "minimum_actual_searches": { "type": "integer", "minimum": 0 },
          "coverage_required": { "const": true },
          "terminal_status": { "const": "pending" },
          "execution_rationale": { "type": "string" },
          "search_instructions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
                  "required": ["instruction_id", "purpose", "search_stage"],
                  "properties": {
                    "instruction_id": { "type": "string", "pattern": "^FS-\\d{3}$" },
                    "purpose": { "type": "string", "minLength": 6 },
                    "source_hint": { "type": "string" },
                    "query_authoring_artifact": { "type": "string" },
                    "search_stage": {
                      "type": "string",
                      "const": "formal_research_execution"
                    }
                  },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "research_discipline": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
