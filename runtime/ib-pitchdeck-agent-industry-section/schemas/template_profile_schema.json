{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template Profile",
  "description": "Deterministic, analyzable profile of a PPT template including style, geometry, and capacity.",
  "type": "object",
  "required": [
    "schema_version",
    "template_file",
    "visual_style",
    "text_geometry",
    "render_layouts",
    "page_type_capability",
    "source_area",
    "density_budget",
    "source_policy"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "template_profile_v1" },
    "template_file": { "type": "string" },
    "analysis_source": { "type": "string" },
    "analysis_error": { "type": "string" },
    "analysis_fallback": { "type": "boolean" },
    "render_layouts_source": { "type": "string" },
    "text_fit_rules_source": { "type": "string" },
    "layout_budget_source": { "type": "string" },
    "ppt_mapping_source": { "type": "string" },
    "visual_style": {
      "type": "object",
      "required": ["colors", "typography"],
      "properties": {
        "colors": {
          "type": "object",
          "required": ["brand_primary", "accent_red", "grid_gray", "text_gray"],
          "properties": {
            "brand_primary": { "type": "string" },
            "accent_red": { "type": "string" },
            "grid_gray": { "type": "string" },
            "text_gray": { "type": "string" },
            "panel_fill": { "type": "string" },
            "matrix_axis": { "type": "string" },
            "additionalProperties": false
          },
          "additionalProperties": true
        },
        "typography": {
          "type": "object",
          "required": ["body", "table_header", "table_body", "legend_pt"],
          "properties": {
            "body": { "type": "string" },
            "table_header": { "type": "string" },
            "table_body": { "type": "string" },
            "legend_pt": { "type": "number" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "text_geometry": {
      "type": "object",
      "additionalProperties": true
    },
    "template_inventory": {
      "type": "object",
      "properties": {
        "slide_count": { "type": "integer", "minimum": 0 },
        "page_size": { "type": "object", "additionalProperties": true },
        "slides": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "aggregate_roles": { "type": "object", "additionalProperties": true },
        "analysis_fallback": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "render_layouts": {
      "type": "object",
      "required": ["slides"],
      "properties": {
        "slides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "page_type_capability": {
      "type": "object",
      "required": ["schema_version", "page_types"],
      "properties": {
        "schema_version": { "type": "string", "const": "page_type_capability_v1" },
        "page_types": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["page_type", "slides", "supports"],
            "properties": {
              "page_type": { "type": "string" },
              "slides": { "type": "array", "items": { "type": "integer" } },
              "supports": { "type": "object", "additionalProperties": { "type": "boolean" } },
              "required_body_fields": { "type": "array", "items": { "type": "string" } },
              "render_layouts": { "type": "array", "items": { "type": "string" } },
              "density_classes": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "source_area": {
      "type": "object",
      "required": ["schema_version", "source_footer_fields", "source_slots", "has_detected_source_area"],
      "properties": {
        "schema_version": { "type": "string", "const": "source_area_v1" },
        "required_source_footer": { "type": "boolean" },
        "source_footer_fields": { "type": "array", "items": { "type": "string" } },
        "source_slots": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "has_detected_source_area": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "density_budget": {
      "type": "object",
      "required": ["schema_version", "slides"],
      "properties": {
        "schema_version": { "type": "string", "const": "density_budget_v1" },
        "global": { "type": "object", "additionalProperties": true },
        "slides": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "dynamic_slots": {
      "type": "object",
      "properties": {
        "slide_count": { "type": "integer", "minimum": 0 },
        "slides": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "properties": {
        "render_layouts": {
          "type": "object",
          "required": ["slides"],
          "properties": {
            "slides": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "layout_budget": {
          "type": "object",
          "additionalProperties": true
        },
        "text_fit_rules": {
          "type": "object",
          "properties": {
            "fields": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "slide_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_no", "page_type", "render_layout", "supports"],
        "properties": {
          "slide_no": { "type": "integer", "minimum": 1 },
          "page_type": { "type": "string" },
          "render_layout": { "type": "string" },
          "supports": {
            "type": "object",
            "properties": {
              "chart": { "type": "boolean" },
              "table": { "type": "boolean" },
              "matrix": { "type": "boolean" },
              "cards": { "type": "boolean" }
            },
            "required": ["chart", "table", "matrix", "cards"],
            "additionalProperties": false
          },
          "required_body_fields": { "type": "array", "items": { "type": "string" } },
          "capacity_rules": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      }
    },
    "source_policy": {
      "type": "object",
      "required": ["source_footer_fields"],
      "properties": {
        "source_footer_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_source_footer": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
