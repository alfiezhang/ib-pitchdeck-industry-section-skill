{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Industry Scope Pack v2",
  "description": "Brief industry boundary card. It defines research scope and reconciliation rules; it is not a research memo and must not contain market findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "scope_summary",
    "scope_classification",
    "must_reconcile",
    "boundary_validation_needed",
    "handoff_to_research",
    "do_not_use_as_claims"
  ],
  "properties": {
    "schema_version": { "const": "industry_scope_pack_v2" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_company", "transaction_type", "geography", "language", "prepared_date"],
      "properties": {
        "target_company": { "type": "string" },
        "transaction_type": { "type": "string" },
        "geography": { "type": "string" },
        "language": { "type": "string" },
        "prepared_date": { "type": "string" }
      }
    },
    "scope_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_market", "parent_market", "broader_market"],
      "properties": {
        "working_market": { "type": "string", "minLength": 1 },
        "parent_market": { "type": "string", "minLength": 1 },
        "broader_market": { "type": "string", "minLength": 1 }
      }
    },
    "scope_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "broad", "adjacent", "excluded"],
      "properties": {
        "core": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "broad": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string" }
        },
        "adjacent": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string" }
        },
        "excluded": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        }
      }
    },
    "must_reconcile": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "why_it_matters", "research_instruction"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "why_it_matters": { "type": "string", "minLength": 1 },
          "research_instruction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "boundary_validation_needed": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "why_needed", "suggested_validation_source"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "why_needed": { "type": "string", "minLength": 1 },
          "suggested_validation_source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "handoff_to_research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_scope", "do_not_use_as_market_scope", "must_label_when_used"],
      "properties": {
        "research_scope": { "type": "string", "minLength": 1 },
        "do_not_use_as_market_scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "must_label_when_used": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "do_not_use_as_claims": { "const": true }
  }
}
